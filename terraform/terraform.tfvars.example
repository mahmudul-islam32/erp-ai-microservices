# Example Terraform variables file
# Copy this to terraform.tfvars and update with your values

aws_region = "us-east-1"
project_name = "erp-microservices"
environment = "production"

# EC2 Instance Configuration
instance_type = "t3.medium"  # t2.micro for free tier, t3.medium recommended
volume_size   = 30           # GB

# Key Pair Configuration
# Option 1: Use existing key pair (recommended)
create_key_pair = false
key_pair_name   = "erp-ec2-key"

# Option 2: Create new key pair (requires public_key)
# create_key_pair = true
# key_pair_name   = "erp-ec2-key"
# public_key      = "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAACAQC... your-public-key"

# Security Configuration
# IMPORTANT: Change this to your IP address for better security
# Get your IP: curl ifconfig.me
allowed_ssh_cidr_blocks = ["YOUR_IP_ADDRESS/32"]  # Example: ["203.0.113.0/32"]

# Network Configuration
allocate_elastic_ip = true  # Recommended to prevent IP changes
